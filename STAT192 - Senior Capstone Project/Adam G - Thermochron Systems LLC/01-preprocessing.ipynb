    "import pickle\n",
    "\n",
    "# Output directory: the same folder this notebook lives in, so 02–04 can\n",
    "# load via a relative path. Resolves at runtime to the project workspace.\n",
    "OUTPUT_DIR = Path.cwd()\n",
    "BCA_LONG_PATH = OUTPUT_DIR / \"bca_long.parquet\"\n",
    "BCA_LONG_CSV_PATH = OUTPUT_DIR / \"bca_long.csv\"\n",
    "BCA_WIDE_CSV_PATH = OUTPUT_DIR / \"bca_wide.csv\"\n",
    "DATAFRAMES_PKL_PATH = OUTPUT_DIR / \"dataframes.pkl\"\n",
    "\n",
    "# --- Remove invalid post-correction negative BCA values before downstream analysis ---\n",
    "invalid_negative_counts = {}\n",
    "for key in bca_keys:\n",
    "    df = dataframes[key].copy()\n",
    "    dwell_cols = [c for c in df.columns if c != \"time_sec\"]\n",
    "    negative_mask = df[dwell_cols] < 0\n",
    "    negative_count = int(negative_mask.sum().sum())\n",
    "    if negative_count:\n",
    "        invalid_negative_counts[key] = negative_count\n",
    "        df[dwell_cols] = df[dwell_cols].mask(negative_mask)\n",
    "        dataframes[key] = df\n",
    "\n",
    "total_invalid_negative_values = int(sum(invalid_negative_counts.values()))\n",
    "print(f\"Invalid negative BCA values removed after baseline reversal: {total_invalid_negative_values}\")\n",
    "\n",
    "# --- Build the wide-format BCA DataFrame ---\n",
    "wide_rows = []\n",
    "for key in bca_keys:\n",
    "    df = dataframes[key].copy()\n",
    "    lab, run_id = key.split(\"/\", 1)\n",
    "    df.insert(0, \"row_id\", np.arange(len(df)))\n",
    "    df.insert(0, \"run_id\", run_id)\n",
    "    df.insert(0, \"lab\", lab)\n",
    "    wide_rows.append(df)\n",
    "\n",
    "bca_wide = pd.concat(wide_rows, ignore_index=True)\n",
    "\n",
    "# --- Build the long-format BCA DataFrame ---\n",
    "long_rows = []\n",
    "for key in bca_keys:\n",
    "    df = dataframes[key]\n",
    "    lab, run_id = key.split(\"/\", 1)\n",
    "    metadata = bca_metadata.get(key, {})\n",
    "    set_label = metadata.get(\"set\")\n",
    "    amu = metadata.get(\"amu\")\n",
    "    dwell_cols = [c for c in df.columns if c != \"time_sec\"]\n",
    "    for dwell_time_label in dwell_cols:\n",
    "        try:\n",
    "            dwell_time = float(dwell_time_label)\n",
    "        except ValueError:\n",
    "            # Skip any column whose name isn't a numeric dwell-time string\n",
    "            continue\n",
    "        sub = pd.DataFrame({\n",
    "            \"lab\": lab,\n",
    "            \"set\": set_label,\n",
    "            \"run_id\": run_id,\n",
    "            \"dwell_time\": dwell_time,\n",
    "            \"amu\": amu,\n",
    "            \"time_sec\": df[\"time_sec\"].values,\n",
    "            \"intensity\": df[dwell_time_label].values,\n",
    "        })\n",
    "        long_rows.append(sub)\n",
    "\n",
    "bca_long = pd.concat(long_rows, ignore_index=True)\n",
    "bca_long = bca_long.dropna(subset=[\"intensity\"]).reset_index(drop=True)\n",
    "\n",
    "print(f\"Long-format BCA DataFrame: {bca_long.shape}\")\n",
