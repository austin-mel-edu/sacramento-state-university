   "source": [
    "# Match \"He <one or more digits>.txt\" exactly (case-sensitive on the prefix).\n",
    "_HE_NUMBER_RE = re.compile(r\"^He\\s+\\d+\\.txt$\")\n",
    "\n",
    "dataframes: dict[str, pd.DataFrame] = {}\n",
    "bca_metadata: dict[str, dict[str, str | None]] = {}\n",
    "errors: list[tuple[str, str]] = []\n",
    "pbca_skipped: list[str] = []\n",
    "\n",
    "for subdir in subdirs:\n",
    "    txt_files = sorted(\n",
    "        p for p in subdir.glob(\"*.txt\") if _HE_NUMBER_RE.match(p.name)\n",
    "    )\n",
    "    print(f\"{subdir.name}: {len(txt_files)} 'He <number>.txt' files\")\n",
    "    for txt in txt_files:\n",
    "        key = f\"{subdir.name}/{txt.stem}\"\n",
    "        try:\n",
    "            parsed_df = parse_mass_spec_file(txt)\n",
    "            dataframes[key] = parsed_df\n",
    "            bca_metadata[key] = {\"set\": parsed_df.attrs.get(\"set\"), \"amu\": parsed_df.attrs.get(\"amu\")}\n",
    "        except PBCASkipped as e:\n",
    "            pbca_skipped.append(key)\n",
    "            print(f\"  [PBCA skipped] {key}\")\n",
    "        except Exception as e:  # noqa: BLE001\n",
    "            errors.append((key, str(e)))\n",
    "\n",
    "print(f\"\\nLoaded {len(dataframes)} DataFrames.\")\n",
    "print(f\"Skipped {len(pbca_skipped)} PBCA file(s).\")\n",
    "if errors:\n",
    "    print(f\"{len(errors)} files failed to parse:\")\n",
    "    for key, msg in errors[:10]:\n",
    "        print(f\"  {key}: {msg}\")\n",
    "    if len(errors) > 10:\n",
    "        print(f\"  ... and {len(errors) - 10} more\")"
   ]
  },
