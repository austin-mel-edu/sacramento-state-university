    "## 4. File parser\n",
    "\n",
    "Reads one `.txt` file with defensive handling for messy inputs:\n",
    "1. Reads all lines and treats any line that contains only whitespace and/or NULL bytes (`\\x00`) as blank. The actual files have leading and/or trailing blank-or-NULL lines that need to be skipped.\n",
    "2. Locates the **first non-blank line** and verifies it's the metadata-plus-header row by checking it contains a field equal to `time_sec`. If not, the file is rejected.\n",
    "3. Splits that header line on **tabs or runs of 2+ spaces** so multi-word fields stay atomic (`He 656`, `dwell time calibration 1`, `All Channels 5.5 amu Dwell Time Test`, `6 amu`, `5.5 amu`, etc.). Keeps the pre-`time_sec` set label and the post-`time_sec` mass labels.\n",
    "4. Decides BCA vs. PBCA vs. experimental:\n",
    "   - **BCA** (all mass labels identical, **6 intensity columns**) → column names = Prisma Pro dwell times (`PRO_DWELL_TIMES`).\n",
    "   - **PBCA** (all mass labels identical, **5 intensity columns**) → a different experiment type that did not pan out. Raise a `PBCASkipped` exception so the loader can tally it separately and exclude it from analysis.\n",
    "   - **Experimental** (mass labels not identical) → column names = mass labels.\n",
    "5. Parses remaining non-blank lines as whitespace-separated numbers, coerces every column to numeric, then drops only rows that are **entirely NULL** (every column NaN). Rows with one missing channel but a valid timestamp are preserved.\n",
    "6. **Timestamp-reset cleanup:** the first few rows can be junk readings whose timestamps don't fit the monotonically-increasing pattern of the real measurement. Detected by finding the last index where `time_sec` decreases relative to the previous row; everything before that index is dropped.\n",
    "7. **BCA user-error correction:** for BCA files only, if any data value is negative, the operator forgot to disable the instrument's automatic baseline subtraction. The reference column (`0.512`) was treated as baseline and subtracted from all other data columns. The fix adds `0.512` back to the other data columns row-by-row; the reference column itself is left untouched. A short notice is printed when this triggers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "ec8f7d37-025d-4fde-9e5d-871fdd8f77d8",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-05-15T02:51:45.093200Z",
     "iopub.status.busy": "2026-05-15T02:51:45.092196Z",
     "iopub.status.idle": "2026-05-15T02:51:45.101613Z",
     "shell.execute_reply": "2026-05-15T02:51:45.101613Z"
    }
   },
   "outputs": [],
   "source": [
    "# Hardcoded dwell-time array for the Prisma Pro instrument.\n",
    "PRO_DWELL_TIMES = [\"0.128\", \"0.256\", \"0.512\", \"1.024\", \"2.048\", \"4.096\"]\n",
    "PLUS_DWELL_TIME = [\"0.1\", \"0.2\", \"0.5\", \"1.0\", \"2.0\", \"5.0\"]\n",
    "\n",
    "# Header fields are separated by tabs OR runs of 2+ spaces. Single internal spaces stay intact so multi-word fields are preserved\n",
    "_HEADER_SPLIT_RE = re.compile(r\"\\t+| {2,}\")\n",
    "\n",
    "# Characters that count as \"empty\" content for blank/NULL line detection.\n",
    "_BLANK_CHARS = \"\\x00 \\t\\r\\n\"\n",
    "\n",
    "\n",
    "class PBCASkipped(Exception):\n",
    "    \"\"\"Raised when a file is identified as a PBCA (5 intensity columns)\n",
    "    rather than a proper BCA. PBCAs are a separate experiment type that\n",
    "    is excluded from this analysis.\"\"\"\n",
    "\n",
    "\n",
    "def _is_blank(line: str) -> bool:\n",
    "    \"\"\"True if the line contains only whitespace and/or NULL bytes.\"\"\"\n",
    "    return line.strip(_BLANK_CHARS) == \"\"\n",
    "\n",
    "\n",
    "def parse_mass_spec_file(path: Path) -> pd.DataFrame:\n",
    "    \"\"\"Parse a single mass spectrometer .txt file into a DataFrame.\n",
    "\n",
    "    Robust to leading/trailing/interior blank-or-NULL lines. Locates the\n",
    "    first non-blank line dynamically and verifies it's the metadata-plus-header\n",
    "    row (contains a `time_sec` field). All data rows are coerced to numeric;\n",
    "    rows with any non-numeric or missing value are dropped.\n",
    "\n",
    "    The first column is always `time_sec`. Remaining columns are named by\n",
    "    Prisma Pro dwell time (BCA files) or by mass label (experimental files).\n",
    "\n",
    "    Raises `PBCASkipped` if the file is detected as a PBCA (5 intensity\n",
    "    columns rather than 6). The caller is expected to catch this and\n",
    "    exclude the file from analysis.\n",
    "    \"\"\"\n",
    "    with open(path, \"r\", errors=\"replace\") as f:\n",
    "        raw_lines = f.readlines()\n",
    "\n",
    "    # --- Locate the header: first non-blank line ---\n",
    "    header_idx = None\n",
    "    for i, line in enumerate(raw_lines):\n",
    "        if not _is_blank(line):\n",
    "            header_idx = i\n",
    "            break\n",
    "    if header_idx is None:\n",
    "        raise ValueError(f\"File {path} contains no non-blank lines.\")\n",
    "\n",
    "    header_line = raw_lines[header_idx].strip(_BLANK_CHARS)\n",
    "    header_fields = [f.strip() for f in _HEADER_SPLIT_RE.split(header_line)]\n",
    "    header_fields = [f for f in header_fields if f]\n",
    "\n",
    "    # --- Verify it's actually the metadata + column-label row ---\n",
    "    if \"time_sec\" not in header_fields:\n",
    "        raise ValueError(\n",
    "            f\"First non-blank line of {path} is not a metadata/header row \"\n",
    "            f\"(no 'time_sec' field). First fields seen: {header_fields[:6]}\"\n",
    "        )\n",
    "    ts_idx = header_fields.index(\"time_sec\")\n",
    "    set_label = header_fields[1] if ts_idx >= 2 else None\n",
    "    mass_labels = header_fields[ts_idx + 1:]\n",
    "    if not mass_labels:\n",
    "        raise ValueError(f\"No mass labels found after 'time_sec' on header of {path}.\")\n",
    "\n",
    "    # --- BCA detection: all mass labels identical ---\n",
    "    is_bca = len(set(mass_labels)) == 1\n",
    "\n",
    "    if is_bca:\n",
    "        # PBCA: same shape but five intensity columns instead of six.\n",
    "        if len(mass_labels) == len(PRO_DWELL_TIMES) - 1:\n",
    "            raise PBCASkipped(\n",
    "                f\"{path.name}: PBCA (5 intensity columns) — excluded from analysis\"\n",
    "            )\n",
    "        if len(mass_labels) != len(PRO_DWELL_TIMES):\n",
    "            raise ValueError(\n",
    "                f\"BCA file {path} has {len(mass_labels)} data columns but \"\n",
    "                f\"PRO_DWELL_TIMES has {len(PRO_DWELL_TIMES)} entries.\"\n",
    "            )\n",
    "        data_columns = list(PRO_DWELL_TIMES)\n",
    "    else:\n",
    "        data_columns = mass_labels\n",
    "\n",
    "    column_names = [\"time_sec\"] + data_columns\n",
    "\n",
    "    # --- Collect non-blank data lines after the header ---\n",
    "    data_lines = [\n",
    "        line.strip(_BLANK_CHARS)\n",
    "        for line in raw_lines[header_idx + 1:]\n",
    "        if not _is_blank(line)\n",
    "    ]\n",
    "    if not data_lines:\n",
    "        raise ValueError(f\"File {path} has no data rows after the header.\")\n",
    "\n",
    "    # --- Parse with pandas (\\s+ handles tab- and space-separated values) ---\n",
    "    df = pd.read_csv(\n",
    "        io.StringIO(\"\\n\".join(data_lines)),\n",
    "        sep=r\"\\s+\",\n",
    "        header=None,\n",
    "        names=column_names,\n",
    "        engine=\"python\",\n",
    "        on_bad_lines=\"skip\",\n",
    "    )\n",
    "\n",
    "    # --- Coerce every column to numeric; drop rows with any missing field ---\n",
    "    for col in df.columns:\n",
    "        df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
    "    df = df.dropna(how=\"any\").reset_index(drop=True)\n",
    "\n",
    "    # --- Timestamp-reset cleanup ---\n",
    "    # The first few rows can be junk readings; the real measurement begins\n",
    "    # where time_sec resumes a monotonically-increasing pattern. Find the\n",
    "    # last row index where time_sec decreases vs. the previous row, and drop\n",
    "    # everything before it.\n",
    "    if len(df) >= 2:\n",
    "        decreases = df[\"time_sec\"].diff() < 0\n",
    "        if decreases.any():\n",
    "            last_reset = decreases[decreases].index.max()\n",
    "            df = df.iloc[last_reset:].reset_index(drop=True)\n",
    "\n",
    "    # --- BCA user-error correction ---\n",
    "    # In BCA runs, a negative data value indicates the operator forgot to\n",
    "    # disable the instrument's automatic baseline subtraction. Reverse it by\n",
    "    # adding the reference column ('0.512') back to all other data columns,\n",
    "    # row by row. The reference column itself is left as-is.\n",
    "    if is_bca and not df.empty:\n",
    "        data_cols = [c for c in df.columns if c != \"time_sec\"]\n",
    "        if (df[data_cols] < 0).any().any():\n",
    "            ref_col = \"1.024\"\n",
    "            if ref_col in df.columns:\n",
    "                other_data_cols = [c for c in data_cols if c != ref_col]\n",
    "                df[other_data_cols] = df[other_data_cols].add(df[ref_col], axis=0)\n",
    "                print(f\"  [BCA auto-subtraction reversed] {path.name}: added '{ref_col}' back to {other_data_cols}\")\n",
    "\n",
    "    if df.empty:\n",
    "        raise ValueError(f\"File {path} has no valid numeric rows after cleaning.\")\n",
    "\n",
    "    df.attrs[\"set\"] = set_label\n",
    "    df.attrs[\"amu\"] = mass_labels[0] if is_bca else None\n",
    "\n",
    "    return df"
   ]
  },
